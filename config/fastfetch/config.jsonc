{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "/home/guddu/.config/fastfetch/duck.png",
    "type": "kitty-icat",
    "height": 22,
    "width": 20,
    "padding": {
      "right": 5,
      "left": 0,
      "top": 0,
      "bottom": 1
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    "break",
    {
      "type": "title",
      "key": "\uf007 Master",
      "keyWidth": 15,
      "format": "{user-name}",
      "keyColor": "#78824b"
    },
    {
      "type": "title",
      "key": "\uf108 Host",
      "keyWidth": 15,
      "format": "{host-name}",
      "keyColor": "#78824b"
    },
    {
      "type": "os",
      "key": "\uf303 OS",
      "keyWidth": 15,
      "keyColor": "#78824b"
    },
    {
      "type": "shell",
      "key": "\uf120 Shell",
      "keyWidth": 15,
      "keyColor": "#78824b"
    },
    {
      "type": "wm",
      "key": "\uf2d0 WM",
      "keyWidth": 15,
      "keyColor": "#78824b"
    },
    {
      "type": "uptime",
      "key": "\uf017 Uptime",
      "keyWidth": 15,
      "keyColor": "#78824b"
    },
    {
      "type": "cpu",
      "key": "\uf2db CPU",
      "keyWidth": 15,
      "keyColor": "#78824b"
    },
    {
      "type": "gpu",
      "key": "\uf085 GPU",
      "keyWidth": 15,
      "hideType": "integrated",
      "keyColor": "#78824b"
    },
    {
      "type": "media",
      "key": "\uf001 Music",
      "keyWidth": 15,
      "format": "{artist} - {title}",
      "keyColor": "#78824b"
    },
    {
      "type": "colors"
    },
    "break"
  ]
}